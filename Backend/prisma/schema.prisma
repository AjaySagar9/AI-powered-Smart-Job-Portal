generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  applications     Application[]
  bookmarks        Bookmark[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  emailTokens      EmailVerificationToken[]
  passwordTokens   PasswordResetToken[]
  refreshTokens    RefreshToken[]
}

model CandidateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeUrl       String?
  skills          String[]
  bio             String?
  headline        String?
  experienceYears Int?     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resumes   Resume[]
}

model RecruiterProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs      Job[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  logoUrl     String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recruiters  RecruiterProfile[]
  jobs        Job[]
}

model Job {
  id                  String          @id @default(uuid())
  title               String
  description         String
  location            String?
  employmentType      EmploymentType  @default(FULL_TIME)
  workMode            WorkMode        @default(ONSITE)
  status              JobStatus       @default(DRAFT)
  experienceMin       Int?            @default(0)
  experienceMax       Int?
  salaryMin           Float?
  salaryMax           Float?
  skills              String[]
  qualification       String?
  responsibilities    String[]
  benefits            String[]
  applicationDeadline DateTime?
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterId         String
  recruiter           RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  applications        Application[]
  bookmarks           Bookmark[]
  jobSkills           JobSkill[]
}

model Skill {
  id        String     @id @default(uuid())
  name      String     @unique
  jobSkills JobSkill[]
}

model JobSkill {
  jobId   String
  skillId String
  job     Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(PENDING)
  resumeId    String?
  resume      Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter String?
  notes       String?           // Recruiter notes
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, candidateId])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  notes         String?
  createdAt     DateTime          @default(now())
}

model Resume {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  fileUrl            String
  fileName           String
  fileSize           Int?
  mimeType           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  applications       Application[]
}

model Bookmark {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([jobId, candidateId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
